server {
    listen 80 default_server;
    server_name ruiyu.work www.ruiyu.work;
    return 301 https://ruiyu.work$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name ruiyu.work www.ruiyu.work;

    ssl_certificate /etc/nginx/ssl/ruiyu.work_bundle.pem;
    ssl_certificate_key /etc/nginx/ssl/ruiyu.work.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/schedule-manager;
    index index.html;

    # 病历、聊天和备忘录文件上传上限
    client_max_body_size 100m;

    # PDF.js 使用 ES module worker，必须以 JavaScript 类型返回 .mjs
    location ~ \.mjs$ {
        types { application/javascript mjs; }
        try_files $uri =404;
    }

    # 登录、注册及所有后端接口
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React 页面与刷新路由
    location / {
        try_files $uri $uri/ /index.html;
    }
}
